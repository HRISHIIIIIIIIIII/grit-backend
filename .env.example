# --- App ---
GRIT_ENV=development
GRIT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
GRIT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GRIT_REFRESH_TOKEN_EXPIRE_DAYS=14
GRIT_DEFAULT_TIMEZONE=Europe/Berlin

# --- Database (async URL for the API) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
GRIT_DATABASE_URL=postgresql+asyncpg://grit:grit@localhost:5432/grit
# Sync URL for Celery workers + Alembic (psycopg). Derived from DATABASE_URL if omitted.
GRIT_SYNC_DATABASE_URL=postgresql+psycopg://grit:grit@localhost:5432/grit

# --- Redis / Celery ---
GRIT_REDIS_URL=redis://localhost:6379/0
GRIT_CELERY_BROKER_URL=redis://localhost:6379/1
GRIT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS (comma-separated origins for the web frontend) ---
GRIT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
